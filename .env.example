# BudgetX Backend Environment
# Copy to `.env` and adjust. Never commit your real `.env`.

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-long-random-string-hex-or-uuid-at-least-32-chars
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./budgetx.db
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://budgetx:budgetx@localhost:5432/budgetx

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PRODUCTION=https://budget-x-ch9q.vercel.app

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (get from https://developer.apple.com/account/resources/identifiers)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
